        "properties": {
          "x_min": {
            "type": "number",
            "description": "Pixels"
          },
          "y_min": {
            "type": "number",
            "description": "Pixels"
          },
          "x_max": {
            "type": "number",
            "description": "Pixels"
          },
          "y_max": {
            "type": "number",
            "description": "Pixels"
          }
        },
