            },
            "x_min": {
              "type": "number",
              "description": "Pixels"
            },
            "y_min": {
              "type": "number",
              "description": "Pixels"
            },
            "x_max": {
              "type": "number",
              "description": "Pixels"
            },
            "y_max": {
              "type": "number",
              "description": "Pixels"
            }
          },
          "required": [
            "id",
            "team",
            "x_min",
            "x_max",
            "y_min",
            "y_max"
          ]
        }
